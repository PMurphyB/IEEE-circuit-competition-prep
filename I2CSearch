void printDeviceInfo(uint8_t address){
  I2CDeviceMasterInfo info = sensorInfo(address);
  Serial.println(address, HEX);

  Serial.print("Name: ");
  Serial.println(info.name);

  Serial.print("Device Type: ");
  Serial.println(info.deviceType); 

  Serial.print("Variables the device measures: ");
  Serial.println(info.measures);

  Serial.print("Possible addresses for this device: ");
  Serial.println(info.possibleAddresses); 

  Serial.print("Sleep mode notes: ");
  Serial.println(info.sleepModeNotes); 

  Serial.print("commonLibararies: "); 
  Serial.println(info.commonLibararies);

};


uint8_t foundAddresses[128]; 
int foundCount = 0;

void scanI2C() {
  foundCount = 0;

  Serial.println("Scanning I2C bus...");
  
  for (uint8_t address = 0x08; address <= 0x77; address++) {
    Wire.beginTransmission(address);
    uint8_t error = Wire.endTransmission();

    if (error == 0) {
      foundAddresses[foundCount] = address;
      foundDevices[foundCount].address = address;

      printDeviceInfo(address); 
      foundCount++;

      Serial.print("Device found at address 0x");
      if (address < 16) Serial.print("0");
      Serial.println(address, HEX);
    }
    else if (error == 4) {
      Serial.print("Unknown error at address 0x");
      if (address < 16) Serial.print("0");
      Serial.println(address, HEX);
    }
  }

  Serial.println();
  Serial.print("Total devices found: ");
  Serial.println(foundCount);

  if (foundCount > 0) {
    Serial.println("Stored addresses in bin:");
    for (int i = 0; i < foundCount; i++) {
      Serial.print("bin[");
      Serial.print(i);
      Serial.print("] = 0x");
      if (foundAddresses[i] < 16) Serial.print("0");
      Serial.println(foundAddresses[i], HEX);
    }
  } else {
    Serial.println("No I2C devices found.");
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  Wire.begin(SDA_PIN, SCL_PIN);

  Serial.println("ESP32 I2C Scanner");
  Serial.print("Using SDA = ");
  Serial.println(SDA_PIN);
  Serial.print("Using SCL = ");
  Serial.println(SCL_PIN);
  Serial.println();

  scanI2C();
}

void loop() {
  scanI2C();
  Serial.println("------------------");
  delay(3000);
}
